# Firebase (client)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_USE_FIREBASE_EMULATORS=false

# Firebase (server) — a dedicated Firebase Auth user, NOT a GCP service account.
# Create it in Firebase Console > Authentication > Users > Add user, with a
# long randomly-generated password. Must match firestore.rules' subscriptions
# match block if you use a different email than the default.
FIREBASE_SERVICE_EMAIL=experiments@genuinecro.com
FIREBASE_SERVICE_PASSWORD=

# PayPal (server)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Required: webhook calls are rejected unless PayPal's signature verifies
# against this ID (Developer Dashboard > your app > Webhooks).
PAYPAL_WEBHOOK_ID=
# The billing plan IDs you sell. The plan a customer gets is derived from these
# on the server — the browser's plan name is ignored. Subscription.tsx must send
# the same IDs.
PAYPAL_PLAN_ID_PRO=
PAYPAL_PLAN_ID_AGENCY=
# "live" (default) or "sandbox". Each needs its own credentials, plan IDs and webhook ID.
PAYPAL_ENV=live
# Extra origins PayPal may redirect customers back to (comma-separated).
# FRONTEND_URL, genuinecro.com and app.genuinecro.com are always allowed.
ALLOWED_RETURN_ORIGINS=

# Proxies in front of the Node app (rate limits key on the client IP).
TRUST_PROXY_HOPS=1

# Analysis (server)
FIRECRAWL_API_KEY=
OPENAI_API_KEY=

# Google Analytics 4 integration (server) — from a Google Cloud project's
# OAuth 2.0 Client (APIs & Services > Credentials > Create Credentials >
# OAuth client ID > Web application). Enable the "Google Analytics Admin
# API" and "Google Analytics Data API" on that project. Add
# GOOGLE_OAUTH_REDIRECT_URI as an Authorized redirect URI on the client —
# it must exactly match, including scheme and path (e.g.
# https://yourdomain.com/api/ga4/oauth/callback, or
# http://localhost:3000/api/ga4/oauth/callback for local dev).
# While the OAuth consent screen is in "Testing" mode, only accounts you add
# as test users can connect, and refresh tokens expire after 7 days — submit
# the app for Google verification before relying on this for real users.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/ga4/oauth/callback
# Where the OAuth callback redirects back to after connecting (the Vite dev
# server in local dev, or your production domain).
FRONTEND_URL=http://localhost:8080
